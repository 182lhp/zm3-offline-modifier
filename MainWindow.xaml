                                        <StackPanel>
                                            <ItemsControl x:Name="PetAbilities" Margin="0,4,0,9">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource GoldWash}" CornerRadius="8" Padding="10" Margin="0,0,7,0"><StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource GoldInk}" TextAlignment="Center"/>
                                                    <TextBlock Text="{Binding Total}" Foreground="{StaticResource Green}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl x:Name="PetQualityMeters" ItemTemplate="{StaticResource PetMeterRow}"/>
