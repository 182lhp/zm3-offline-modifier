                                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                </ListBox>
                                                <TextBlock Text="穿戴时，同栏位的旧装备会自动放回背包。操作先加入存档，保存后生效。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="SkillsPage" Visibility="Collapsed" IsVisibleChanged="SkillsVisibilityChanged">
