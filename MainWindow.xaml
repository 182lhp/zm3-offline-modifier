                                        Style="{StaticResource PetSmallButton}" Foreground="#A24B35" BorderBrush="#D3AC9D"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,0,0,0" ToolTip="放生当前选中的宠物；穿戴装备会保留到宠物背包。"/>
                                <StackPanel x:Name="PetExperiencePanel" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,5"><TextBlock Text="经验" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PetExperienceText" Text="—" TextAlignment="Right" FontSize="12"/></DockPanel>
                                    <ProgressBar x:Name="PetExperienceBar" Height="5" Foreground="{StaticResource GoldInk}" Background="{StaticResource GoldWash}" BorderThickness="0"/>
                                </StackPanel>
                                </Grid>
                                <UniformGrid x:Name="PetActions" Grid.Row="5" Columns="2" Margin="-3,10,-3,0" IsEnabled="False">
                                    <Button x:Name="FightButton" Content="出战" Style="{StaticResource Primary}" Click="FightPet" Margin="3" Padding="8,6"/>
                                    <Button x:Name="RestButton" Content="休息" Click="RestPet" Margin="3" Padding="8,6"/>
                                </UniformGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <TabControl x:Name="PetTabs" Style="{StaticResource SegmentTabs}" IsEnabled="False">
