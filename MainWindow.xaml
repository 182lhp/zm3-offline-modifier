                                            <DockPanel Margin="8,0"><TextBlock Text="HP" VerticalAlignment="Center" FontWeight="Bold"/><TextBlock x:Name="PetHealthText" Text="—" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                                        </Grid>
                                        <Grid Height="24" Margin="0,0,0,6">
                                            <ProgressBar x:Name="PetManaBar" Maximum="1" BorderThickness="0" Foreground="#518AAB" Background="{StaticResource GoldWash}" Opacity=".35"/>
                                            <DockPanel Margin="8,0"><TextBlock Text="MP" VerticalAlignment="Center" FontWeight="Bold"/><TextBlock x:Name="PetManaText" Text="—" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                                        </Grid>
                                        <ItemsControl x:Name="PetMetrics" ToolTip="静态属性包含常驻技能、装备强化与匹配套装；关卡临时增益以游戏为准。">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Background="{StaticResource Canvas}" CornerRadius="5" Padding="7,4" Margin="0,0,5,5">
                                                    <DockPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Text}" TextAlignment="Right" FontWeight="SemiBold"/></DockPanel>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Row="4" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
