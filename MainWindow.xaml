                                            <Button x:Name="EditPetValuesButton" Content="编辑具体数值" Click="EditPet" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="编辑当前选中宠物的等级、潜力、资质与成长；也可双击左侧列表中的宠物。"/>
                                        </WrapPanel>
                                        <ScrollViewer x:Name="PetCultivationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <Border Background="{StaticResource GoldWash}" CornerRadius="7" Padding="10,5" Margin="0,2,0,8"><DockPanel>
                                                    <TextBlock Text="可用潜力点" Foreground="{StaticResource GoldInk}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="PetPotentialPoints" Text="—" Foreground="{StaticResource Green}" FontSize="28" FontWeight="SemiBold" TextAlignment="Right"/>
                                                </DockPanel></Border>
                                                <ItemsControl x:Name="PetGrowthRows">
                                                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Canvas}" CornerRadius="7" Padding="9,5" Margin="0,0,0,6">
                                                        <Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Green}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Total}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Green}" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Center"/>
                                                            <Grid Grid.Column="2" Margin="8,0,10,0" Height="20" VerticalAlignment="Center">
                                                                <ProgressBar Value="{Binding Value}" Maximum="{Binding Maximum}" Foreground="{StaticResource Green}" Opacity=".3" Background="{StaticResource GoldWash}" BorderThickness="0"/>
                                                                <TextBlock Text="{Binding Progress}" Foreground="{StaticResource Green}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                                                            </Grid>
                                                            <Button Content="培养 +1" Grid.Column="3" Tag="{Binding Basis}" Click="CultivatePet" IsEnabled="{Binding CanGrow}" Style="{StaticResource PetSmallButton}" Padding="8,4" MinHeight="30" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
