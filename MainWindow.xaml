                                            <Button x:Name="PetReturnButton" Content="放回背包" Click="ReturnPetEquipment" Style="{StaticResource PetSmallButton}" Margin="0,0,6,5" IsEnabled="False"/>
                                            <Button x:Name="PetTuneButton" Content="调整属性" Click="TunePetEquipment" Style="{StaticResource PetSmallButton}" Margin="0,0,6,5" IsEnabled="False"/>
                                            <Button x:Name="PetDeleteGearButton" Content="删除装备" Click="DeletePetEquipment" Style="{StaticResource PetSmallButton}" Margin="0,0,6,5" IsEnabled="False" Foreground="#A24B35" BorderBrush="#D3AC9D" ToolTip="删除当前选中的穿戴装备或背包装备，确认后移除。"/>
