                                                <TextBlock x:Name="PetGearHint" Foreground="{StaticResource Green}" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                                <DockPanel Margin="0,0,0,8"><TextBlock Text="宠物背包" Style="{StaticResource DetailSection}" Margin="0"/><TextBlock x:Name="PetBackpackCount" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></DockPanel>
                                                <TextBlock x:Name="PetBackpackHint" Text="背包为空，可从物品库添加宠物装备。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
