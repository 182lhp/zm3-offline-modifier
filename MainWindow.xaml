                                                        <StackPanel><Grid Width="48" Height="48" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Initial}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid><TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border x:Name="PetSourceCard" Style="{StaticResource SourceCard}" Visibility="Collapsed" Margin="0,10,0,0">
                                                <StackPanel><TextBlock Text="捕捉与获取" Foreground="{StaticResource GoldInk}" FontWeight="SemiBold" Margin="0,0,0,3"/><TextBlock x:Name="PetSource" Style="{StaticResource SourceText}"/></StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="PetCultivationTab" Header="培 养">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
