<Window x:Class="GmStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="造梦西游 3 · 修改器" Icon="gm.ico" Width="1440" Height="900" MinWidth="1050" MinHeight="675"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Closing="OnClosing" PreviewKeyDown="OnShortcut">


    <Grid Background="{StaticResource Canvas}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Background="{StaticResource Sidebar}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="19,18,18,13">
                <DockPanel LastChildFill="False">
                    <Border Width="44" Height="44" CornerRadius="11">
                        <Image Source="gm-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </DockPanel>
                <TextBlock Text="造梦西游 3" Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,13,0,5"/>
                <TextBlock Text="修改器  /  天庭图鉴" Foreground="#E0C897" FontSize="13"/>
            </StackPanel>
            <ScrollViewer x:Name="SidebarScroll" Grid.Row="1" Margin="14,4,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="SidebarItems" Margin="0,0,4,0">
                <TextBlock x:Name="NavGroupCore" Text="角色与物品" FontSize="11" Foreground="#A0B6A9" TextTrimming="CharacterEllipsis"/>
                <RadioButton x:Name="NavCatalog" Style="{StaticResource Nav}" Tag="&#xE14C;" Content="图鉴" Click="Navigate" IsChecked="True"/>
                <RadioButton x:Name="NavRole" Style="{StaticResource Nav}" Tag="&#xE13D;" Content="角色" Click="Navigate"/>
                <RadioButton x:Name="NavSkills" Style="{StaticResource Nav}" Tag="&#xE8F1;" Content="技能" Click="Navigate"/>
                <RadioButton x:Name="NavPets" Style="{StaticResource Nav}" Tag="&#xE734;" Content="宠物" Click="Navigate"/>
                <TextBlock x:Name="NavGroupTools" Text="进阶工具" FontSize="11" Foreground="#A0B6A9" TextTrimming="CharacterEllipsis"/>
                <RadioButton x:Name="NavVip" Style="{StaticResource Nav}" Tag="&#xE735;" Content="会员" Click="Navigate"/>
                <RadioButton x:Name="NavGarden" Style="{StaticResource Nav}" Tag="&#xE8A1;" Content="药园" Click="Navigate"/>
                <RadioButton x:Name="NavBuff" Style="{StaticResource Nav}" Tag="&#xE945;" Content="增益" Click="Navigate"/>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="14,12,14,16">
                <Button x:Name="SettingsButton" Style="{StaticResource SidebarAction}" Click="ShowSettings" Margin="0,0,0,7">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="设置"/></StackPanel>
                </Button>
                <Button x:Name="AdvancedToolsButton" Style="{StaticResource SidebarAction}" Click="OpenAdvancedTools">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="高级工具"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="{StaticResource Surface}" Padding="22,14">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <StackPanel Width="156" Margin="0,0,10,0">
                            <TextBlock Text="存档槽" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SlotsBox" SelectionChanged="SlotChanged" AutomationProperties.Name="存档槽"/>
                        </StackPanel>
                        <StackPanel Width="156">
                            <TextBlock Text="选择角色" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="PlayersBox" SelectionChanged="PlayerChanged" AutomationProperties.Name="选择角色"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="HelpButton" Content="使用说明书" Click="HelpClick" Margin="0,0,8,0" ToolTip="F1"/>
                        <Button Content="刷新" Click="RefreshClick" Margin="0,0,8,0" ToolTip="重新读取磁盘上的存档"/>
                        <Button x:Name="SaveButton" Content="保存" Click="SaveClick" Style="{StaticResource Primary}" MinWidth="90" ToolTip="先保存到本地并备份旧文件；同一目录的游戏服务在线时自动推送。角色数据需回游戏重新读档。快捷键 Ctrl+S。"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="22,19,22,16">
                <Grid x:Name="CatalogPage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Margin="0,0,0,14" Padding="16,11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F3E6C9"/>
                                <GradientStop Color="#FCF8EF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="4399 装备道具 ↗" Tag="equipment" Click="OpenGuide"
                                    Style="{StaticResource GuideLink}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="天庭图鉴  /  大闹天庭篇" Foreground="{StaticResource GoldInk}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="物品库" Style="{StaticResource Title}" Margin="0,2,0,3"/>
                                <TextBlock x:Name="CatalogBadge" Text="连接游戏目录后可查阅离线物品图鉴" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="274"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid x:Name="CatalogFilterBar">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <WrapPanel x:Name="CatalogFilters" Margin="0,0,16,0">
                                        <StackPanel Width="130" Margin="0,0,9,8">
                                            <TextBlock Text="分类" Style="{StaticResource Label}"/>
                                            <ComboBox x:Name="CategoryBox" SelectionChanged="FilterChanged" AutomationProperties.Name="物品分类"/>
                                        </StackPanel>
                                        <StackPanel Width="110" Margin="0,0,9,8">
                                            <TextBlock Text="品质" Style="{StaticResource Label}"/>
                                            <ComboBox x:Name="QualityBox" SelectionChanged="FilterChanged" AutomationProperties.Name="物品品质"/>
                                        </StackPanel>
                                        <StackPanel Width="110" Margin="0,0,9,8">
                                            <TextBlock Text="适用角色" Style="{StaticResource Label}"/>
                                            <ComboBox x:Name="CatalogRoleBox" SelectionChanged="FilterChanged" AutomationProperties.Name="图鉴适用角色"
                                                      ToolTip="选择角色时包含该角色专用及通用物品，仅筛选图鉴，不切换正在编辑的角色。"/>
                                        </StackPanel>
                                        <StackPanel Width="280" Margin="0,0,9,8">
                                            <TextBlock Text="搜索名称、编号或细类" Style="{StaticResource Label}"/>
                                            <TextBox x:Name="SearchBox" TextChanged="FilterChanged" AutomationProperties.Name="搜索名称、编号或细类"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Button x:Name="CatalogClearButton" Grid.Column="1" Content="清空" VerticalAlignment="Bottom" Click="ClearSearch" Padding="9,7" Margin="0,0,0,8"/>
                                </Grid>
                                <DataGrid x:Name="CatalogTable" Grid.Row="1" SelectionChanged="ItemSelected"
                                          SizeChanged="CatalogTableSizeChanged" Sorting="SortCatalog"
                                          Style="{StaticResource CompactGuideTable}" AutomationProperties.Name="物品列表">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="物品" Width="4*" CellStyle="{StaticResource IllustratedCell}"
                                                                HeaderStyle="{StaticResource GuideNameHeader}" SortMemberPath="Name"
                                                                CellTemplate="{StaticResource GuideRow}"/>
                                        <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" SortMemberPath="TypeName" Width="1.5*"/>
                                        <DataGridTemplateColumn Header="品质" Width="*" MinWidth="68" SortMemberPath="Quality"
                                                                CellTemplate="{StaticResource QualityPill}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                    <StackPanel x:Name="CatalogPager" DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="False">
                                        <TextBlock Text="每页" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,5,0"/>
                                        <ComboBox x:Name="CatalogSizeBox" Width="65" MinHeight="32" Padding="5,3"
                                                  DisplayMemberPath="Label" SelectedValuePath="Count"
                                                  SelectionChanged="CatalogPageSizeChanged" AutomationProperties.Name="每页条数"/>
                                        <Button x:Name="CatalogPrevious" Content="上一页" MinHeight="32" Padding="8,4"
                                                Margin="8,0,4,0" Click="PreviousCatalogPage"/>
                                        <TextBox x:Name="CatalogPageBox" Width="36" MinHeight="32" Padding="3,4"
                                                 PreviewKeyDown="CatalogPageKeyDown" AutomationProperties.Name="当前页，回车跳转"
                                                 ToolTip="输入页码后按 Enter 跳转"/>
                                        <TextBlock x:Name="CatalogPageTotal" Text="/ 0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Muted}" Margin="4,0"/>
                                        <Button x:Name="CatalogNext" Content="下一页" MinHeight="32" Padding="8,4" Click="NextCatalogPage"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ResultCount" Text="尚未连接游戏目录" Foreground="{StaticResource Muted}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button x:Name="GiveButton" Content="加入当前存档" Style="{StaticResource Primary}" Click="GiveClick" IsEnabled="False"/>
                                <TextBlock Text="保存后生效" TextAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="物品详情" Style="{StaticResource DetailSection}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding SelectedItem, ElementName=CatalogTable}" ContentTemplate="{StaticResource GuidePortrait}"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ItemTitle" Text="请选择物品" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="ItemCode" Foreground="{StaticResource Muted}" Margin="0,3,0,4" TextTrimming="CharacterEllipsis"/>
                                            <ContentPresenter Content="{Binding SelectedItem, ElementName=CatalogTable}"
                                                              ContentTemplate="{StaticResource QualityPill}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="ItemDescription" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18"/>
                                    <TextBlock x:Name="ItemType" Foreground="{StaticResource GoldInk}" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="ItemUser" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <Border x:Name="ItemSourceCard" Style="{StaticResource SourceCard}" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="获取途径" Foreground="{StaticResource GoldInk}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="ItemSource" Style="{StaticResource SourceText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,9"/>
                                    <StackPanel x:Name="ItemGrantFields">
                                    <TextBlock x:Name="ItemTarget" Text="先选择存档和角色" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    <DockPanel Margin="0,3,0,7">
                                        <TextBlock Text="发放到　" Foreground="{StaticResource Muted}"/>
                                        <TextBlock x:Name="ItemDestination" Text="—" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="数量" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button DockPanel.Dock="Right" Content="+ 10" Click="AddTen" Padding="8,6" Margin="7,0,0,0" MinHeight="35"/>
                                        <TextBox x:Name="ItemQuantity" Text="1" AutomationProperties.Name="物品数量"/>
                                    </DockPanel>
                                    <CheckBox x:Name="UseReference" Content="装备按参考属性生成" IsChecked="True" Margin="0,0,0,5"/>
                                    <CheckBox x:Name="GiveMaxed" Content="一键生成极品装备"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                          </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="RolePage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,15">
                        <Button DockPanel.Dock="Right" Content="4399 装备道具 ↗" Tag="equipment" Click="OpenGuide" Style="{StaticResource GuideLink}" VerticalAlignment="Center"/>
                        <StackPanel><TextBlock Text="角色" Style="{StaticResource Title}"/><TextBlock Text="查看角色形象与属性，管理背包、穿戴和装备。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="RoleProfileCard" Style="{StaticResource Card}" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="角色档案" Style="{StaticResource DetailSection}" Margin="0,0,0,7"/>
                                    <TextBlock x:Name="RoleProfileEmpty" Text="选择一个存档和角色即可查看。" Foreground="{StaticResource Muted}"/>
                                    <StackPanel x:Name="RoleProfileContent" Visibility="Collapsed">
                                        <TextBlock x:Name="RoleProfileName" FontSize="23" FontWeight="Bold"/>
                                        <TextBlock x:Name="RoleProfileContext" Foreground="{StaticResource Muted}" Margin="0,3,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border CornerRadius="11" Height="128">
                                                <Border.Background>
                                                    <RadialGradientBrush Center=".47,.48" GradientOrigin=".47,.48" RadiusX=".72" RadiusY=".73">
                                                        <GradientStop Color="#FFFCF1"/>
                                                        <GradientStop Color="#EBDBB6" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                                <Grid Margin="8">
                                                    <TextBlock x:Name="RolePortraitPlaceholder" Text="形象资源不可用" Foreground="{StaticResource GoldInk}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image x:Name="RolePortraitImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="RoleProfileLevel" Foreground="{StaticResource Green}" FontWeight="Bold" FontSize="28"/>
                                                <TextBlock x:Name="RoleProfilePower" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,3"/>
                                                <TextBlock x:Name="RoleProfileSoul" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="RoleProfileStage" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="RolePortraitNote" Text="部分形象资源不可用，已使用基础部件。" Foreground="{StaticResource Muted}"
                                                   FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                        <TextBlock x:Name="RoleProfileExperience" FontSize="12" Foreground="{StaticResource GoldInk}" Margin="0,9,0,4"/>
                                        <ProgressBar x:Name="RoleExperienceBar" Height="6" Foreground="{StaticResource Green}" Background="{StaticResource GoldWash}"
                                                     BorderThickness="0" AutomationProperties.Name="经验进度"/>
                                        <ItemsControl x:Name="RoleMetrics" Margin="0,9,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="7,4" Margin="0,0,5,4" Background="{StaticResource JadeWash}" CornerRadius="5">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" Margin="0,0,3,0"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="当前穿戴" Style="{StaticResource DetailSection}" Margin="0,5,0,5"/>
                                        <ItemsControl x:Name="RoleWornSlots">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,5,4" Padding="4" Background="{StaticResource Canvas}" CornerRadius="5" ToolTip="{Binding Hint}">
                                                        <DockPanel>
                                                            <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,4,0"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource GoldInk}"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="属性按当前存档中的修改及已保存的增益计算。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Grid x:Name="BagWorkspace" Grid.Column="2" SizeChanged="RoleWorkspaceSizeChanged">

                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="BagColumnGap" Width="12"/><ColumnDefinition x:Name="BagDetailsColumn" Width="280"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition x:Name="BagListRow" Height="*"/><RowDefinition x:Name="BagRowGap" Height="0"/><RowDefinition x:Name="BagDetailRow" Height="0"/></Grid.RowDefinitions>
                        <Border x:Name="BagListCard" Style="{StaticResource Card}" Padding="14">
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="背包与穿戴" Style="{StaticResource DetailSection}" Margin="0,0,0,9"/>
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button x:Name="MaxWornButton" DockPanel.Dock="Right" Content="穿戴全极品" Click="MaxWorn" Padding="9,7"
                                        IsEnabled="False"/>
                                <ComboBox x:Name="BagFilter" Width="138" HorizontalAlignment="Left" SelectionChanged="BagFilterChanged"
                                          AutomationProperties.Name="背包栏位"/>
                            </DockPanel>
                            <DataGrid x:Name="BagTable" Grid.Row="2" MouseDoubleClick="EquipmentDoubleClick" SelectionChanged="BagSelected"
                                      Style="{StaticResource CompactGuideTable}" AutomationProperties.Name="背包物品">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="物品" Width="4*" CellStyle="{StaticResource IllustratedCell}"
                                                            HeaderStyle="{StaticResource GuideNameHeader}" SortMemberPath="Name"
                                                            CellTemplate="{StaticResource GuideRow}"/>
                                    <DataGridTextColumn Header="栏位" Binding="{Binding Category}" Width="1.5*"/>
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="*" MinWidth="68"/>
                                </DataGrid.Columns>
                            </DataGrid>
                          </Grid>
                        </Border>
                        <Border x:Name="BagDetailCard" Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="-3,8,-3,0">
                                    <Button x:Name="WearButton" Content="穿戴" Click="MoveEquipment" Margin="3" Padding="6,5" IsEnabled="False"/>
                                    <Button x:Name="TuneButton" Content="调整属性" Style="{StaticResource Primary}" Click="EditEquipment"
                                            Margin="3" Padding="6,5" IsEnabled="False"/>
                                    <Button x:Name="MaxItemButton" Content="设为极品" Click="MaxEquipment" Margin="3" Padding="6,5" IsEnabled="False"/>
                                    <Button x:Name="RemoveItemButton" Content="移除物品" Click="RemoveItem" Margin="3" Padding="6,5" IsEnabled="False"/>
                                </UniformGrid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="背包详情" Style="{StaticResource DetailSection}" Margin="0,0,0,8"/>
                                        <ContentPresenter Content="{Binding SelectedItem, ElementName=BagTable}" ContentTemplate="{StaticResource GuideRow}"/>
                                        <TextBlock x:Name="BagSummary" Text="选择一项物品查看详情。" Foreground="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,8,0,6"/>
                                        <Border x:Name="BagSourceCard" Style="{StaticResource SourceCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="获取途径" Foreground="{StaticResource GoldInk}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="BagSource" Style="{StaticResource SourceText}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="BagStatPanel" Visibility="Collapsed">
                                            <UniformGrid Columns="3" Background="{StaticResource GoldWash}" Margin="0,3,0,3">
                                                <TextBlock Text="属性" TextAlignment="Center" Margin="0,5"/>
                                                <TextBlock Text="当前值" TextAlignment="Center" Margin="0,5"/>
                                                <TextBlock Text="参考上限" TextAlignment="Center" Margin="0,5"/>
                                            </UniformGrid>
                                            <ItemsControl x:Name="BagStats" AutomationProperties.Name="装备属性与参考上限">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                                            <UniformGrid Columns="3" Margin="0,5">
                                                                <TextBlock Text="{Binding Name}" TextAlignment="Center"/>
                                                                <TextBlock Text="{Binding Current}" TextAlignment="Center" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Limit}" TextAlignment="Center" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource Green}"/>
                                                            </UniformGrid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="PetsPage" Visibility="Collapsed">
                    <Grid.Resources>
                        <Style x:Key="PetSmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="32"/>
                        </Style>
                        <Style x:Key="PetMaxAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#F3D58F"/><Setter Property="Foreground" Value="#684211"/>
                            <Setter Property="BorderBrush" Value="#D3AE5A"/><Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="44"/>
                        </Style>
                        <Style x:Key="PetTileItem" TargetType="ListBoxItem">
