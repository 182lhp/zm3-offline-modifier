                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SkillTitle" Text="技能等级（0–3）" Style="{StaticResource SkillLabel}"/>
                                        <TextBox x:Name="SkillLevelBox" Grid.Column="1" Style="{StaticResource SkillInput}" AutomationProperties.Name="主动技能等级"/>
                                        <Button Grid.Column="2" Content="应用" Style="{StaticResource SkillAction}" Click="SetSkillLevel"/>
                                        <TextBlock x:Name="SchoolTitle" Grid.Row="2" Text="心法等级（0–5）" Style="{StaticResource SkillLabel}"/>
                                        <TextBox x:Name="SchoolLevelBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource SkillInput}" AutomationProperties.Name="心法等级"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="应用" Style="{StaticResource SkillAction}" Click="SetSchoolLevel"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                                <StackPanel>
                                    <DockPanel Height="32" Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="角色通用 · 0–5 级" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="被动技能" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Border Background="#F3EDDF" Height="29" Padding="10,0">
                                        <DockPanel TextElement.Foreground="{StaticResource Muted}" TextElement.FontSize="12" TextElement.FontWeight="SemiBold">
                                            <TextBlock DockPanel.Dock="Right" Width="84" Text="等级" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="技能与效果" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <ItemsControl x:Name="PassiveList" AutomationProperties.Name="被动技能等级">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="40" BorderThickness="0,0,0,1" BorderBrush="#F0E8D9" Padding="10,0">
                                                    <Border.ToolTip><ToolTip Style="{StaticResource SkillHintToolTip}" Content="{Binding Hint}"/></Border.ToolTip>
                                                    <DockPanel>
                                                        <ComboBox DockPanel.Dock="Right" Width="84" MinHeight="29" Padding="5,2"
                                                                  ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding DraftLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                                                        <Border DockPanel.Dock="Left" Width="34" Height="34" Background="{Binding Tile}" CornerRadius="7" Margin="0,0,9,0">
                                                            <Path Data="{Binding Glyph}" Fill="{Binding Ink}" Width="20" Height="20" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Effect}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="选好等级后统一应用" Style="{StaticResource SkillLabel}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                        <Button x:Name="ApplyPassiveButton" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                                                Content="应用被动等级" Style="{StaticResource SkillAction}" Click="ApplyPassive"/>
                                        <TextBlock Grid.Row="2" Text="当前角色灵魂" Style="{StaticResource SkillLabel}"/>
                                        <TextBox x:Name="SkillSoulBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource SkillInput}" AutomationProperties.Name="灵魂"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="应用" Style="{StaticResource SkillAction}" Click="SetSkillSoul"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="GardenPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="GardenBatchButton" Content="批量种植" Click="PlantAllPlots" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button Content="更多设置" Click="GardenMore"/></StackPanel>
                        <StackPanel><TextBlock Text="药园" Style="{StaticResource Title}"/><TextBlock Text="药园管理地块；土地庙独立升级，两项经验分别保存。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <Button x:Name="GardenExpButton" Content="药园经验" Click="EditGardenExp" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,8" Margin="9,0,0,0"/>
                                <Grid Width="54" Height="58" Margin="0,0,12,0"><Image x:Name="GardenSoil" Width="54" Height="30" VerticalAlignment="Bottom"/><Image x:Name="GardenGrass" Width="37" Height="49" Margin="0,0,0,8" VerticalAlignment="Bottom"/></Grid>
                                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="GardenLevelText" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="GardenSummary" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <Button x:Name="TempleEditButton" Content="土地庙经验" Click="EditTemple" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,8" Margin="9,0,0,0"/>
                                <Image x:Name="TemplePortrait" Width="54" Height="58" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TempleLevelText" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="TempleSummary" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="252"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="9">
                            <ListBox x:Name="GardenTable" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource UtilityTileItem}" SelectionChanged="GardenSelected" MouseDoubleClick="PlotDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="药园地块">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel>
                                        <DockPanel><TextBlock Text="{Binding Title}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding State}" FontSize="11" TextAlignment="Right" Foreground="{StaticResource Green}"/></DockPanel>
                                        <Grid Height="78" Margin="0,3,0,2"><Image Source="{Binding Soil}" Width="116" Height="54" VerticalAlignment="Bottom" Stretch="Uniform"/><Image Source="{Binding Crop}" Width="61" Height="68" Margin="0,0,0,12" VerticalAlignment="Bottom" Stretch="Uniform"/></Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Grade}" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="GardenSelectionTitle" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock x:Name="GardenSelectionState" Foreground="{StaticResource Green}" Margin="0,7,0,14"/>
                                    <Border Background="{StaticResource GoldWash}" CornerRadius="12" Height="112"><Image x:Name="GardenSelectionImage" Height="86" Width="110"/></Border>
                                    <TextBlock x:Name="GardenSelectionName" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                    <TextBlock x:Name="GardenSelectionDescription" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="GardenSelectionDate" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,17" TextWrapping="Wrap"/>
                                    <Button x:Name="GardenPlantButton" Content="种植 / 编辑" Style="{StaticResource Primary}" Click="EditPlot" Margin="0,0,0,8"/>
                                    <Button x:Name="GardenRenewButton" Content="翻新这块地" Click="RenewSelectedPlot" Margin="0,0,0,14"/>
                                    <TextBlock Text="植物在当前游戏包中即种即收。操作保存后，回游戏读档并收获。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="BuffPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14"><Button Content="更多设置" DockPanel.Dock="Right" Click="BuffMore" VerticalAlignment="Center"/><StackPanel><TextBlock Text="增益" Style="{StaticResource Title}"/><TextBlock Text="选择增益卡片，设置强度和时长。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,13">
                        <DockPanel><Button x:Name="BuffPresetButton" Content="一键添加推荐增益" DockPanel.Dock="Right" Click="MaxBuffs" Style="{StaticResource Primary}"/><StackPanel><TextBlock x:Name="BuffSummary" FontSize="21" FontWeight="Bold"/><TextBlock Text="7 种常用增益 · 推荐时长 1 小时 · 保存后生效" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="10">
                            <ListBox x:Name="BuffTable" BorderThickness="0" Background="Transparent" Padding="0" ItemContainerStyle="{StaticResource UtilityTileItem}" SelectionChanged="BuffSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="增益卡片">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel MinHeight="90">
                                        <DockPanel><Border Width="42" Height="42" Background="{StaticResource GoldWash}" CornerRadius="9" Margin="0,0,10,0"><Grid><TextBlock Text="✦" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource GoldInk}"/><Image Source="{Binding Icon}" Width="32" Height="32"/></Grid></Border><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ValueText}" Foreground="{StaticResource Green}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></DockPanel>
                                        <DockPanel Margin="0,12,0,0"><TextBlock Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Duration}" Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Right"/></DockPanel>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,13"><Image x:Name="BuffDetailIcon" Width="36" Height="36" Margin="0,0,11,0"/><TextBlock x:Name="BuffDetailTitle" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                                    <TextBlock x:Name="BuffDetailDescription" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,17"/>
                                    <TextBlock x:Name="BuffValueLabel" Text="数值" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="BuffValueBox" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,13" AutomationProperties.Name="增益强度"/>
                                    <TextBlock Text="持续时间" Style="{StaticResource Label}"/><ComboBox x:Name="BuffDurationBox" SelectionChanged="BuffDurationChanged" Margin="0,0,0,12" AutomationProperties.Name="增益持续时间"/>
                                    <StackPanel x:Name="BuffExactDuration" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock Text="精确帧数（1–86400）" Style="{StaticResource Label}"/><TextBox x:Name="BuffFramesBox" Text="86400" AutomationProperties.Name="增益精确帧数"/></StackPanel>
                                    <TextBlock x:Name="BuffLimitHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>
                                    <Button x:Name="BuffApplyButton" Content="启用增益" Click="AddBuff" Style="{StaticResource Primary}" Margin="0,0,0,8"/>
                                    <Button x:Name="BuffRemoveButton" Content="移除这项增益" Click="RemoveBuff"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="VipPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,15">
                        <Button x:Name="VipMoreButton" DockPanel.Dock="Right" Content="更多设置" Click="VipMore" VerticalAlignment="Center"/>
                        <StackPanel><TextBlock Text="会员与点券" Style="{StaticResource Title}"/><TextBlock Text="选择会员等级，管理点券，领取已解锁礼包。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource GoldWash}" CornerRadius="13" Width="60" Height="60" Margin="0,0,15,0" VerticalAlignment="Top"><Image Source="{StaticResource VipCrownIcon}" Width="34" Height="34"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="当前会员" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="VipTitle" Text="VIP 0" FontSize="28" FontWeight="Bold" Margin="0,3,0,8" Foreground="{StaticResource Green}"/><TextBlock x:Name="VipProgress" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="15,0,0,0" Width="125"><TextBlock Text="选择 VIP 等级" Style="{StaticResource Label}"/><ComboBox x:Name="VipLevelBox" SelectionChanged="VipLevelChanged" AutomationProperties.Name="VIP 等级"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                                    <DockPanel>
                                        <Button x:Name="VipRechargeButton" Content="点券充值" DockPanel.Dock="Right" Click="RechargeVip" Style="{StaticResource Primary}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><Image Source="{StaticResource VipCoinIcon}" Width="19" Height="19" Margin="0,0,7,0"/><TextBlock Text="点券余额" Foreground="{StaticResource Muted}"/></StackPanel>
                                            <TextBlock x:Name="VipBalance" FontSize="28" FontWeight="Bold" Margin="0,4,0,8"/>
                                            <WrapPanel><TextBlock Text="累计充值 " Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="VipAll" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="   ·   累计消费 " Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="VipPaid" Foreground="{StaticResource Muted}" FontSize="11"/></WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button x:Name="VipClaimButton" Content="一键领取礼包" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="ClaimVipGifts"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource VipGiftIcon}" Width="25" Height="25" Margin="0,0,9,0"/><TextBlock Text="VIP 礼包" FontSize="19" FontWeight="Bold"/></StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="VipGiftSummary" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>
                                    <ItemsControl x:Name="VipGiftList">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Background="{StaticResource Canvas}" CornerRadius="10" Padding="12" Margin="0,0,8,8" MinHeight="103">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <Border Background="{StaticResource GoldWash}" CornerRadius="9" Width="44" Height="44" Margin="0,0,10,0" VerticalAlignment="Top"><Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
                                                        <StackPanel><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                                    </DockPanel>
                                                    <DockPanel Grid.Row="1" Margin="0,9,0,0"><TextBlock Text="{Binding Requirement}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/></DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="点券与 VIP 为账号共享；礼包发放到当前存档中已创建的角色。保存后生效。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="RawPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,15">
                        <Button x:Name="ReturnFromRawButton" Content="返回常用页面" DockPanel.Dock="Right" Click="ReturnFromRaw" VerticalAlignment="Center"/>
                        <StackPanel><TextBlock Text="高级工具 / 原始 JSON" Style="{StaticResource Title}"/><TextBlock Text="查看和编辑当前存档槽的完整数据。应用后仍需保存。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="应用到存档" Click="ApplyRawClick" Style="{StaticResource Primary}"
                                    Margin="0,11,0,0" HorizontalAlignment="Right"/>
                            <TextBox x:Name="RawText" TextChanged="RawFormChanged" FontFamily="Consolas, Microsoft YaHei UI"
                                     AcceptsReturn="True" AcceptsTab="True" TextAlignment="Left" VerticalContentAlignment="Top"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,10">
                <DockPanel>
                    <TextBlock x:Name="DirtyBadge" DockPanel.Dock="Right" Text="无待保存修改" Foreground="{StaticResource Green}" FontWeight="SemiBold" Margin="14,0,0,0"/>
                    <TextBlock x:Name="RuntimeStatusText" DockPanel.Dock="Right" Text="状态待检测" Foreground="{StaticResource Muted}" Margin="14,0,0,0"/>
                    <TextBlock x:Name="Status" Text="请选择游戏目录。" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
