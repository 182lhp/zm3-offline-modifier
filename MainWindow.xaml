                                                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"><Run Text="{Binding Level}"/><Run Text=" 级 · "/><Run Text="{Binding Status}"/></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                                    <TextBlock x:Name="PetSummary" DockPanel.Dock="Right" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                                    <TextBlock x:Name="PetTitle" Text="选择宠物" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </DockPanel>
                                <ScrollViewer x:Name="PetMetricsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Grid Height="24" Margin="0,0,0,6">
