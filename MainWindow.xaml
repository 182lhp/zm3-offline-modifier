                                                    <Grid Grid.Column="1" Height="24"><ProgressBar x:Name="PetPotentialBar" Maximum="100" Foreground="{StaticResource GoldInk}" Opacity=".3" Background="{StaticResource GoldWash}" BorderThickness="0"/>
                                                        <TextBlock x:Name="PetPotentialText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GoldInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                                <TextBlock x:Name="PetPotentialWarning" Foreground="#A24B2B" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
