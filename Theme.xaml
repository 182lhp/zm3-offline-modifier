<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Canvas" Color="#F6F1E5"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFDF7"/>
    <SolidColorBrush x:Key="GoldWash" Color="#F3E8D0"/>
    <SolidColorBrush x:Key="GoldInk" Color="#785521"/>
    <SolidColorBrush x:Key="JadeWash" Color="#E5F0E8"/>
    <SolidColorBrush x:Key="Sidebar" Color="#17362F"/>
    <SolidColorBrush x:Key="Ink" Color="#203731"/>
    <SolidColorBrush x:Key="Muted" Color="#52665C"/>
    <SolidColorBrush x:Key="Green" Color="#176854"/>
    <SolidColorBrush x:Key="Line" Color="#E4DAC7"/>
    <DrawingImage x:Key="VipCrownIcon"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#B78327" Geometry="M 3,8 L 11,14 L 18,3 L 25,14 L 33,8 L 29,28 L 7,28 Z"/>
        <GeometryDrawing Brush="#E9BF65" Geometry="M 7,30 L 29,30 L 29,34 L 7,34 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <DrawingImage x:Key="VipCoinIcon"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#B78327"><GeometryDrawing.Geometry><EllipseGeometry Center="18,18" RadiusX="17" RadiusY="17"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#F2D795"><GeometryDrawing.Geometry><EllipseGeometry Center="18,18" RadiusX="13" RadiusY="13"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#997024" Geometry="M 14,8 L 22,8 L 22,12 L 18,12 L 18,24 L 22,24 L 22,28 L 14,28 L 14,24 L 17,24 L 17,12 L 14,12 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <DrawingImage x:Key="VipGiftIcon"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#B78327" Geometry="M 3,13 L 33,13 L 33,20 L 3,20 Z M 6,22 L 30,22 L 30,34 L 6,34 Z"/>
        <GeometryDrawing Brush="#E9BF65" Geometry="M 15,13 L 21,13 L 21,34 L 15,34 Z M 18,11 C 4,12 4,0 11,2 C 17,3 18,11 18,11 M 18,11 C 32,12 32,0 25,2 C 19,3 18,11 18,11"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <DrawingImage x:Key="VipExpIcon"><DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#176854" Geometry="M 3,29 L 12,20 L 18,25 L 31,10 L 25,10 L 25,5 L 38,5 L 38,18 L 33,18 L 33,14 L 18,33 L 12,27 L 7,33 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <Style x:Key="UtilityTileItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="11"/><Setter Property="Margin" Value="3"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Tile" Background="{StaticResource Canvas}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource JadeWash}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Green}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource GoldInk}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Green}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="#DCCFB7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="7"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".80"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".65"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#9B6F32"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value=".40"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#24473C"/><Setter Property="Foreground" Value="#F0F6EF"/><Setter Property="BorderBrush" Value="#3A594D"/>
        <Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Green}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
    </Style>
    <Style x:Key="SegmentTab" TargetType="TabItem">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            TextElement.Foreground="{StaticResource Muted}" TextElement.FontWeight="SemiBold"
                            Padding="{TemplateBinding Padding}" CornerRadius="8">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource Surface}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabSurface" Property="TextElement.Foreground" Value="{StaticResource Green}"/>
                            <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource JadeWash}"/>
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="#B8CFC0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="#9B6F32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegmentTabs" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentTab}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" IsItemsHost="True" Orientation="Horizontal" Margin="0,0,0,8"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Navigation"/>
        <Setter Property="Foreground" Value="#D2E0D7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="Margin" Value="0,1,0,2"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="surface" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="15"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#22473E"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="surface" Property="Background" Value="#2A5144"/>
                            <Setter Property="Foreground" Value="#F6FFFA"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#C4AB6F"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="#FFFCF5"/>
        <Setter Property="BorderBrush" Value="#DCCFB7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="Padding" Value="21,4"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="#FFFCF5"/>
        <Setter Property="BorderBrush" Value="#DCCFB7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" IsTabStop="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                        <Path Data="M 0 0 L 3.5 3.5 L 7 0" Stroke="#506760" StrokeThickness="1.2"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="SelectedItemPresenter" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ClipToBounds="True"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                    Background="{StaticResource Surface}" BorderBrush="#DCCFB7" BorderThickness="1" CornerRadius="5">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#91AD9D"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource Green}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DropDownToggle" Property="Opacity" Value=".55"/>
                            <Setter TargetName="SelectedItemPresenter" Property="Opacity" Value=".55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ChoicePresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#E5F0E8"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#D9EADD"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".55"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#F0E8D9"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="ColumnHeaderHeight" Value="34"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="CompactGuideTable" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="ColumnHeaderHeight" Value="29"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F3EDDF"/>
        <Setter Property="Foreground" Value="#506760"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GuideNameHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#E5F0E8"/>
                <Setter Property="Foreground" Value="#125543"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SourceCard" TargetType="Border">
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
        <Setter Property="Background" Value="{StaticResource GoldWash}"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style x:Key="SourceText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="GuideLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource GoldInk}"/>
        <Setter Property="Background" Value="{StaticResource GoldWash}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="31"/>
    </Style>
    <Style x:Key="IllustratedCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="DetailSection" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldInk}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>
    <DataTemplate x:Key="SkillHintContent">
        <StackPanel MaxWidth="320">
            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Green}"/>
            <TextBlock Text="{Binding Acquisition}" Foreground="{StaticResource GoldInk}" FontWeight="Bold" FontSize="12" Margin="0,5,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding Acquisition}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20"/>
            <TextBlock Text="{Binding Condition}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="12"/>
            <TextBlock Text="{Binding Code}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="SkillHintToolTip" TargetType="ToolTip">
        <Setter Property="ContentTemplate" Value="{StaticResource SkillHintContent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/>
        <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/>
        <Setter Property="MaxWidth" Value="360"/>
    </Style>
    <DataTemplate x:Key="GuideThumb">
        <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource GoldWash}">
            <Grid>
                <TextBlock x:Name="Initial" Text="{Binding Initial}" Foreground="{StaticResource GoldInk}"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="Initial" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="SkillEntryRow">
        <Grid Margin="0,2" Background="Transparent" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
            <Grid.ToolTip><ToolTip Style="{StaticResource SkillHintToolTip}" Content="{Binding Hint}"/></Grid.ToolTip>
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GuideThumb}"/>
            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Caption}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="GuideRow">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GuideThumb}"/>
            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Name}">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Code}" Foreground="{StaticResource Muted}"
                           FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="GuidePortrait">
        <Border Width="70" Height="70" CornerRadius="12" Background="{StaticResource GoldWash}">
            <Grid>
                <TextBlock x:Name="Initial" Text="{Binding Initial}" Foreground="{StaticResource GoldInk}"
                           FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon}" Width="60" Height="60" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="Initial" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="PetDetailEntry">
        <Grid Margin="0,0,5,5" ToolTip="{Binding Code}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="5" Background="{StaticResource GoldWash}">
                <Grid>
                    <TextBlock x:Name="Initial" Text="{Binding Initial}" Foreground="{StaticResource GoldInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="Initial" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="TwoColumns">
        <UniformGrid Columns="2"/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="QualityPill">
        <Border x:Name="Pill" Background="#EEEAE1" CornerRadius="9" Padding="7,3">
            <TextBlock x:Name="QualityText" Text="{Binding Quality}" Foreground="#514D42" FontSize="12"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                <Setter TargetName="Pill" Property="Background" Value="#E3EFE1"/>
                <Setter TargetName="QualityText" Property="Foreground" Value="#26563C"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Quality}" Value="精良">
                <Setter TargetName="Pill" Property="Background" Value="#E3EDF5"/>
                <Setter TargetName="QualityText" Property="Foreground" Value="#30516F"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Quality}" Value="史诗">
                <Setter TargetName="Pill" Property="Background" Value="#ECE4F3"/>
                <Setter TargetName="QualityText" Property="Foreground" Value="#623B76"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Quality}" Value="邪灵">
                <Setter TargetName="Pill" Property="Background" Value="#F4E4E8"/>
                <Setter TargetName="QualityText" Property="Foreground" Value="#833D55"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Quality}" Value="传说">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource GoldWash}"/>
                <Setter TargetName="QualityText" Property="Foreground" Value="{StaticResource GoldInk}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Quality}" Value="魂器">
                <Setter TargetName="Pill" Property="Background" Value="#F5E2D5"/>
                <Setter TargetName="QualityText" Property="Foreground" Value="#863F25"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
