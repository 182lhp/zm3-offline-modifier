<Window x:Class="GmStudio.VipRechargeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点券充值 · 修改器" Icon="gm.ico" Width="530" MinWidth="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Ink}" FontFamily="{DynamicResource InterfaceFont}" FontSize="13" UseLayoutRounding="True">
    <Border Background="{StaticResource Canvas}" Padding="24">
        <StackPanel>
            <DockPanel Margin="0,0,0,20">
                <Border Width="58" Height="58" Background="{StaticResource GoldWash}" CornerRadius="14" Margin="0,0,14,0">
                    <Image Source="{StaticResource VipCoinIcon}" Width="32" Height="32"/>
                </Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="点券充值" FontSize="23" FontWeight="Bold"/><TextBlock Text="增加本地账号点券，保存后生效。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="充值点券数" Style="{StaticResource Label}"/>
                    <TextBox x:Name="AmountBox" Text="10000" FontSize="25" FontWeight="SemiBold" MinHeight="52" TextChanged="Changed" AutomationProperties.Name="充值点券数"/>
                    <UniformGrid Columns="4" Margin="0,10,0,17">
                        <Button Content="1,000" Tag="1000" Click="ChooseAmount" Padding="7,7" Margin="0,0,6,0"/>
                        <Button Content="5,000" Tag="5000" Click="ChooseAmount" Padding="7,7" Margin="0,0,6,0"/>
                        <Button Content="10,000" Tag="10000" Click="ChooseAmount" Padding="7,7" Margin="0,0,6,0"/>
                        <Button Content="50,000" Tag="50000" Click="ChooseAmount" Padding="7,7"/>
                    </UniformGrid>
                    <CheckBox x:Name="CountTotal" Content="计入累计充值，自动提升 VIP 等级" IsChecked="True" Checked="ToggleTotal" Unchecked="ToggleTotal"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource JadeWash}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="充值后余额" Foreground="{StaticResource Muted}"/><TextBlock x:Name="BalancePreview" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="充值后会员" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LevelPreview" FontSize="23" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="TotalPreview" Foreground="{StaticResource Muted}" Margin="2,9,0,0"/>
            <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" IsCancel="True" Click="CancelClick" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="确认充值" IsDefault="True" Style="{StaticResource Primary}" Click="ApplyClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
