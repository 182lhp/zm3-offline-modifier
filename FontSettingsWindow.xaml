<Window x:Class="GmStudio.FontSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字体设置 · 修改器" Width="590" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="13" UseLayoutRounding="True">
    <Border Padding="22,18" Background="{StaticResource Canvas}">
      <StackPanel>
        <TextBlock Text="字体设置" Style="{StaticResource Title}"/>
        <TextBlock Text="分别选择中文和数字／英文字母的字体。保存后立即应用。" Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,5,0,16"/>
        <Grid Margin="0,0,0,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="中文字体" Style="{StaticResource Label}"/>
                <ComboBox x:Name="ChineseBox" DisplayMemberPath="Label" SelectionChanged="PreviewChanged"
                          MaxDropDownHeight="288" AutomationProperties.Name="中文字体"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="数字与英文字母字体" Style="{StaticResource Label}"/>
                <ComboBox x:Name="LatinBox" DisplayMemberPath="Label" SelectionChanged="PreviewChanged"
                          MaxDropDownHeight="288" AutomationProperties.Name="数字与英文字母字体"/>
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="15,12">
            <StackPanel>
                <TextBlock Text="实时预览" Style="{StaticResource DetailSection}" Margin="0,0,0,8"/>
                <StackPanel x:Name="FontPreview">
                    <TextBlock Text="角色 1 · 孙悟空" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="攻击 1250　暴击 18.5%　等级 90" FontSize="15" TextWrapping="Wrap" Margin="0,7,0,4"/>
                    <TextBlock Text="ABC xyz 0123456789 · VIP 5 · tjbg" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="原始 JSON 编辑器使用等宽字体。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock x:Name="SaveError" Visibility="Collapsed" Foreground="#9C412B" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="恢复默认" Click="ResetClick"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="取消" IsCancel="True" Click="CancelClick" MinWidth="72" Margin="0,0,8,0"/>
                <Button Content="保存并应用" IsDefault="True" Style="{StaticResource Primary}" Click="ApplyClick"/>
            </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
</Window>
