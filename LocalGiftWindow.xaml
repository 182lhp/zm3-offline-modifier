<Window x:Class="GmStudio.LocalGiftWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="本地兑换码 · 修改器" Icon="gm.ico" Width="1160" Height="850" MinWidth="900" MinHeight="620"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
 FontFamily="{DynamicResource InterfaceFont}" FontSize="13" UseLayoutRounding="True" Closing="WindowClosing">
 <Border Padding="22" Background="{StaticResource Canvas}"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Border Width="54" Height="54" CornerRadius="13" Background="{StaticResource GoldWash}" Margin="0,0,14,0"><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="{StaticResource GoldInk}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="本地兑换码" FontSize="25" FontWeight="Bold"/><TextBlock Text="修改礼包码与领取规则；回游戏「活动」选择海报和奖励后领取。" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="CodeSummary" Text="兑换码" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
     <TextBox x:Name="SearchBox" Grid.Row="1" ToolTip="搜索礼包名称或兑换码" TextChanged="SearchChanged" Margin="0,0,0,10"/>
     <ListBox x:Name="CodeList" Grid.Row="2" SelectionChanged="CodeChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,7"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Code}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Green}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <UniformGrid Grid.Row="3" Columns="3" Margin="0,12,0,0"><Button Content="新建" Click="NewClick" Padding="5,8" Margin="0,0,5,0"/><Button Content="复制" Click="DuplicateClick" Padding="5,8" Margin="0,0,5,0"/><Button Content="删除" Click="DeleteClick" Padding="5,8"/></UniformGrid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="EditorPanel">
      <TextBlock Text="礼包与领取规则" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="礼包名称" Style="{StaticResource Label}"/><TextBox x:Name="NameBox" MaxLength="60"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="兑换码" Style="{StaticResource Label}"/><TextBox x:Name="CodeBox" MaxLength="64" CharacterCasing="Upper" ToolTip="4–64位字母、数字、横线或下划线"/></StackPanel>
      </Grid>
      <TextBlock Text="礼包说明" Style="{StaticResource Label}" Margin="0,11,0,5"/><TextBox x:Name="DescriptionBox" TextWrapping="Wrap" MaxLength="400" MinHeight="48" VerticalContentAlignment="Center"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="领取规则" Style="{StaticResource Label}"/><ComboBox x:Name="RuleBox" SelectionChanged="RuleChanged"><ComboBoxItem Content="每个存档一次" Tag="once"/><ComboBoxItem Content="每个存档每天一次" Tag="daily"/><ComboBoxItem Content="每个存档指定次数" Tag="limited"/></ComboBox></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="奖励发给" Style="{StaticResource Label}"/><ComboBox x:Name="TargetBox"><ComboBoxItem Content="当前存档所有已创建角色" Tag="all"/><ComboBoxItem Content="角色 1" Tag="player1"/><ComboBoxItem Content="角色 2" Tag="player2"/></ComboBox></StackPanel>
      </Grid>
      <UniformGrid Columns="3" Margin="0,12,0,0">
       <StackPanel Margin="0,0,10,0"><TextBlock Text="每存档次数" Style="{StaticResource Label}"/><TextBox x:Name="PerSaveBox" Text="1"/></StackPanel>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="总次数 · 0 表示不限" Style="{StaticResource Label}"/><TextBox x:Name="TotalBox" Text="0"/></StackPanel>
       <StackPanel><TextBlock Text="到期日期 · 留空永久" Style="{StaticResource Label}"/><DatePicker x:Name="ExpiryBox" SelectedDateFormat="Short" MinHeight="36"/></StackPanel>
      </UniformGrid>
      <DockPanel Margin="0,12,0,16"><CheckBox x:Name="EnabledBox" Content="启用这个兑换码" IsChecked="True"/><TextBlock x:Name="UsageText" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
      <Border Background="{StaticResource GoldWash}" CornerRadius="10" Padding="12">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PresetBox"/><Button Grid.Column="2" Content="载入并替换奖励" Click="LoadPresetClick"/></Grid>
      </Border>
      <DockPanel Margin="0,17,0,9"><TextBlock Text="礼包奖励" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><WrapPanel HorizontalAlignment="Right"><Button Content="物品" Click="AddItemClick" Padding="11,7" Margin="0,0,5,0"/><Button Content="宠物" Click="AddPetClick" Padding="11,7" Margin="0,0,5,0"/><Button Content="灵魂" Click="AddSoulClick" Padding="11,7" Margin="0,0,5,0"/><Button Content="点券" Click="AddPointsClick" Padding="11,7"/></WrapPanel></DockPanel>
      <DataGrid x:Name="RewardGrid" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" MinHeight="150" MaxHeight="245" RowHeight="48" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="奖励" Width="*" MinWidth="220" IsReadOnly="True" CellStyle="{StaticResource IllustratedCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding Icon}" Width="32" Height="32" Margin="6,0,9,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="数量 · 可编辑" Binding="{Binding Count,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="125"/>
       </DataGrid.Columns>
      </DataGrid>
      <Button Content="移除选中奖励" Click="RemoveRewardClick" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="11,7"/>
      <TextBlock Text="物品、宠物和灵魂按目标角色分别发放；点券每次兑换只增加到账户一次。空间不足时整次取消，不消耗次数。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <Expander Header="领取记录" Margin="0,17,0,0"><StackPanel><Button Content="刷新领取记录" Click="RefreshClaimsClick" HorizontalAlignment="Left" Margin="0,8,0,8"/><DataGrid x:Name="ClaimsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="180" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="145"/><DataGridTextColumn Header="存档" Binding="{Binding Slot}" Width="65"/><DataGridTextColumn Header="礼包" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Text="配置保存后立即可在游戏中兑换。不会直接修改当前角色存档。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="关闭" Click="CloseClick" Margin="0,0,8,0"/><Button Content="保存兑换码" Style="{StaticResource Primary}" Click="SaveClick"/></StackPanel>
  </Grid>
 </Grid></Border>
</Window>

