<Window x:Class="GmStudio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 修改器" Icon="gm.ico" Width="640" MinWidth="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="13" UseLayoutRounding="True">
    <Border Padding="24" Background="{StaticResource Canvas}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource GoldWash}" Margin="0,0,14,0"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{StaticResource GoldInk}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="设置" FontSize="24" FontWeight="Bold"/><TextBlock Text="字体、栏目和游戏目录，统一在这里调整。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="字体设置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="分别选择中文和数字／英文字体" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="FontSummary" Foreground="{StaticResource GoldInk}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                        <Button x:Name="FontSettingsButton" Grid.Column="2" Content="调整字体" Click="FontSettingsClick" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="栏目设置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="修改栏目名称，调整上下排列顺序" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SidebarSummary" Foreground="{StaticResource GoldInk}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                        <Button x:Name="SidebarSettingsButton" Grid.Column="2" Content="调整栏目" Click="SidebarSettingsClick" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource GoldInk}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="本地兑换码" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="设置礼包、领取次数与有效期，查看领取记录" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                    <Button x:Name="GiftSettingsButton" Grid.Column="2" Content="管理兑换码" Click="GiftSettingsClick" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="游戏目录" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="存档、图标和游戏资料的位置。选择其他目录后，点击「应用目录」切换。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                        <Border Background="{StaticResource Canvas}" Padding="11" CornerRadius="8"><TextBlock x:Name="DirectoryText" TextWrapping="Wrap" FontSize="12"/></Border>
                        <Button x:Name="ChooseDirectoryButton" Content="选择目录…" HorizontalAlignment="Left" Click="ChooseDirectoryClick" Margin="0,11,0,0"/>
                        <TextBlock x:Name="DirectoryError" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="字体与栏目在各自窗口保存后立即生效。关闭此窗口会取消尚未应用的目录切换。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,12,2,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="CloseSettingsButton" Content="关闭" IsCancel="True" Click="CancelClick" Margin="0,0,8,0"/><Button x:Name="ApplyDirectoryButton" Content="应用目录" Style="{StaticResource Primary}" IsDefault="True" Click="ApplyClick" IsEnabled="False"/></StackPanel>
    </Grid>
    </Border>
</Window>
