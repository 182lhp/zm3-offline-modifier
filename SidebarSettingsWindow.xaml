<Window x:Class="GmStudio.SidebarSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="栏目设置 · 修改器" Width="670" Height="630" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="13" UseLayoutRounding="True">
    <Border Padding="22,18" Background="{StaticResource Canvas}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="栏目设置" Style="{StaticResource Title}"/>
                <TextBlock Text="选择一项后可改名、上移或下移。分组标题也可以调整。" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="13,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="UpButton" Content="↑ 上移" Click="MoveUpClick" MinHeight="28" Padding="8,3"/>
                                <Button x:Name="DownButton" Content="↓ 下移" Click="MoveDownClick" MinHeight="28" Padding="8,3" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="排列顺序" Style="{StaticResource DetailSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="ColumnList" Grid.Row="1" SelectionChanged="SelectionChanged"
                                 AutomationProperties.Name="栏目顺序" Background="#FFFCF5" BorderBrush="{StaticResource Line}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,3"/>
                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="分组标题" Foreground="{StaticResource Muted}"
                                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,9,0,0">
                            <TextBlock Text="显示名称" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NameBox" AutomationProperties.Name="显示名称"
                                     Text="{Binding SelectedItem.Name, ElementName=ColumnList, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                       Text="{Binding SelectedItem.OriginalName, ElementName=ColumnList, StringFormat=默认名称 · {0}}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource Sidebar}" CornerRadius="10" Padding="12,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="侧栏预览" Foreground="#E0C897" FontWeight="SemiBold" Margin="8,1,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SidebarPreview">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="7" Padding="9,3" Margin="0,1,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="#D2E0D7" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Caption" Grid.Column="1" Text="{Binding Name}" Foreground="#D2E0D7"
                                                           FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#2A5144"/>
                                                <Setter TargetName="Caption" Property="Foreground" Value="#F6FFFA"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                <Setter TargetName="Caption" Property="Grid.Column" Value="0"/>
                                                <Setter TargetName="Caption" Property="Grid.ColumnSpan" Value="3"/>
                                                <Setter TargetName="Caption" Property="TextAlignment" Value="Left"/>
                                                <Setter TargetName="Caption" Property="Foreground" Value="#A0B6A9"/>
                                                <Setter TargetName="Caption" Property="FontSize" Value="11"/>
                                                <Setter TargetName="Row" Property="Padding" Value="9,6,9,4"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="SaveError" Visibility="Collapsed" Foreground="#9C412B" TextWrapping="Wrap" Margin="0,0,0,7"/>
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="恢复默认" Click="ResetClick"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="取消" IsCancel="True" Click="CancelClick" MinWidth="72" Margin="0,0,8,0"/>
                        <Button Content="保存并应用" IsDefault="True" Style="{StaticResource Primary}" Click="ApplyClick"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
