<Window x:Class="GmStudio.ResourceVersionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="资源版本 · 修改器" Icon="gm.ico" Width="660" Height="510" MinWidth="520" MinHeight="350"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
 FontFamily="{DynamicResource InterfaceFont}" FontSize="14" UseLayoutRounding="True">
 <Border Padding="24" Background="{StaticResource Canvas}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="资源版本" FontSize="26" FontWeight="Bold"/><TextBlock Text="检查程序和只读资源，不改动存档、领取记录或设置。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,18"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock x:Name="VersionText" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Green}"/><TextBlock x:Name="BuildText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,12"><TextBlock x:Name="ResultText" Text="点击「校验资源」检查当前版本。" TextWrapping="Wrap"/></ScrollViewer>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关闭" IsCancel="True" Click="CloseClick" Margin="0,0,8,0"/><Button x:Name="VerifyButton" Content="校验资源" Style="{StaticResource Primary}" Click="VerifyClick"/></StackPanel>
 </Grid></Border>
</Window>
