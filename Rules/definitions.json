    "skillHelp": {
      "basic": {
        "tsml": "常驻增加宠物攻击力。",
        "zrsh": "常驻增加宠物防御力。",
        "smzf": "常驻增加宠物生命上限。",
        "mfby": "常驻增加宠物魔法上限。",
        "qlfj": "宠物受到攻击时，有一定概率发动反击。",
        "sxkb": "提高宠物的物理暴击率，效果持续一段时间。",
        "fsnl": "提高宠物的技能伤害，效果持续一段时间。",
        "smjc": "为主人增加生命上限，效果持续一段时间。",
        "mfjc": "为主人增加魔法上限，效果持续一段时间。",
        "gjjc": "为主人增加攻击力，效果持续一段时间。",
        "fyjc": "为主人增加防御力，效果持续一段时间。"
      },
      "hero": {
        "slz": "近身上挑，将目标击至空中。",
        "zz": "蓄力后重击前方目标。",
        "sx": "被动提供吸血与暴击效果。",
        "qsez": "向前突进并连续攻击，有机会留下协同攻击的残影。",
        "hmz": "跃入空中进行连续斩击，随后以落地一击收尾。",
        "lys": "快速闪向前方并伤害沿途目标，闪避过程具有无敌效果。",
        "hytj": "向前突击，多次打击并击退目标。",
        "lyfb": "旋转攻击周围目标，造成连续伤害与击退。",
        "jdy": "召唤筋斗云，帮助角色向上移动。",
        "hyjj": "以火眼攻击附近目标，连续造成伤害。",
        "sgq": "蓄力生成光球，接触光球的目标会受到伤害。",
        "myhc": "在范围内持续治疗自身与队友，治疗受生命上限影响。",
        "jgz": "将前方范围内目标聚集，使其承受更多伤害。",
        "tjgl": "治疗范围内自身与队友，治疗受生命上限影响。",
        "jhsj": "以佛经光芒攻击周围目标。",
        "blb": "蓄力放出冰龙，攻击直线路径上的目标。",
        "xbz": "以玄冰攻击周围目标，并降低其移动速度。",
        "shy": "放出向前移动的幻影，可再次施放传送至幻影位置；幻影能配合部分技能。",
        "sjt": "被动改善部分技能的蓄力速度与伤害。",
        "smb": "释放魔法阵与光柱，对选定位置造成伤害。",
        "dj": "用盾击飞前方目标。",
        "sd": "暂时提高生命恢复能力，并抵抗击退。",
        "rj": "被动提高防御，并提供概率生命恢复效果。",
        "zznh": "以怒吼吸引目标，将周围怪物拉向自身。",
        "syzq": "生成向前推进的屏障，伤害接触屏障的目标。",
        "ssp": "连续打击前方目标。",
        "jsp": "重击周围目标，造成范围伤害。",
        "dgq": "化作向前滚动的土球，撞击沿途目标。",
        "xgq": "化作浮空旋转的土球，对附近目标造成伤害。",
        "tmc": "先反弹受到的伤害，再释放飞刺；技能伤害与生命上限有关。",
        "zq": "向前方释放毒气攻击。",
        "mbyj": "投出会在目标间弹射的药剂，每次命中造成短暂眩晕。",
        "wdww": "生成与目标相连的娃娃，将娃娃承受的伤害传递给目标。",
        "jdz": "布置毒阵，目标进入时释放毒烟。",
        "mds": "让技能攻击积累毒素，通过引爆毒素造成额外伤害。",
        "qlj": "以强力攻击击飞前方目标。",
        "tkj": "跃起攻击，对空中目标造成连续伤害。",
        "dzj": "对前方目标发动连续攻击。",
        "lybj": "在地面或空中留下标记，可返回标记位置。",
        "mmw": "发动木系连续攻击，具体攻击形态随当前武器变化。"
      }
