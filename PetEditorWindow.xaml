<Window x:Class="GmStudio.PetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑宠物 · 修改器" Icon="gm.ico" Width="820" Height="810" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Ink}" FontFamily="{DynamicResource InterfaceFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="PetGrowthInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#FAFCF8"/>
            <Setter Property="BorderBrush" Value="#D6E0D8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Green}"/><Setter Property="Background" Value="White"/></Trigger>
                <Trigger Property="IsReadOnly" Value="True"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="{StaticResource Canvas}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PetEditorList" TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource SkillEntryRow}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="7,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetEditorAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Window.Resources>
    <Border Padding="20,16" Background="{StaticResource Canvas}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource GoldWash}" CornerRadius="12" Padding="12,9" Margin="0,0,0,10">
                <DockPanel LastChildFill="True">
                    <ContentPresenter x:Name="PetPortrait" DockPanel.Dock="Left" ContentTemplate="{StaticResource GuidePortrait}"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EditorPurpose" Text="宠物档案  /  编辑" Foreground="{StaticResource GoldInk}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PetName" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,3"/>
                        <TextBlock x:Name="PetMeta" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl x:Name="EditorTabs" Grid.Row="1" Style="{StaticResource SegmentTabs}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem x:Name="GrowthTab" Header="等级与成长">
                    <ScrollViewer x:Name="GrowthScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GrowthFields" Margin="0,0,3,0"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="SkillsTab" Header="技能">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="11">
                            <DockPanel>
                                <TextBlock x:Name="LearnedHeading" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button x:Name="RemoveSkillButton" Content="移除所选" Style="{StaticResource PetEditorAction}" Click="RemoveSkill"/>
                                    <Button x:Name="MoveSkillUpButton" Content="↑ 上移" Style="{StaticResource PetEditorAction}" Click="MoveSkillUp"/>
                                    <Button x:Name="MoveSkillDownButton" Content="↓ 下移" Style="{StaticResource PetEditorAction}" Click="MoveSkillDown"/>
                                </WrapPanel>
                                <ListBox x:Name="LearnedSkills" Style="{StaticResource PetEditorList}" AutomationProperties.Name="已学技能"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="11">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                                    <DockPanel Margin="0,0,0,6">
                                        <ComboBox x:Name="SkillKindBox" DockPanel.Dock="Right" Width="82" MinHeight="29" Padding="4,3"
                                                  AutomationProperties.Name="技能分类"/>
                                        <TextBlock x:Name="AvailableHeading" Text="可选技能" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="搜索名称、别名或编号" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SkillSearch" MinHeight="30" Padding="6,4" AutomationProperties.Name="搜索技能名称或编号"/>
                                </StackPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,7,0,0">
                                    <TextBlock x:Name="SkillDetails" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,0,0,6" MaxHeight="48"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <Button x:Name="AddSkillButton" Content="添加所选" Style="{StaticResource PetEditorAction}" Click="AddSkill"/>
                                </DockPanel>
                                <ListBox x:Name="AvailableSkills" Style="{StaticResource PetEditorList}"
                                         AutomationProperties.Name="可添加技能"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="EditorError" Foreground="#9C412B" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="取消" IsCancel="True" Click="CancelClick" MinWidth="68" Margin="0,0,7,0"/>
                        <Button Content="应用到存档" IsDefault="True" Style="{StaticResource Primary}" Click="ApplyClick"/>
                    </StackPanel>
                    <TextBlock Text="应用后可在主窗口点击「保存」。" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
