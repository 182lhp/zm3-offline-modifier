<Window x:Class="GmStudio.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Ink}" UseLayoutRounding="True">
    <Grid>
        <Border Margin="16" CornerRadius="16" Background="{StaticResource Surface}">
            <Border.Effect>
                <DropShadowEffect Color="#132C25" BlurRadius="22" ShadowDepth="3" Opacity=".23"/>
            </Border.Effect>
        </Border>
        <Border Margin="16" CornerRadius="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="23,22,17,19">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconTile" Width="42" Height="42" CornerRadius="13" Background="{StaticResource JadeWash}"
                            VerticalAlignment="Top" Margin="0,0,14,0">
                        <TextBlock x:Name="IconMark" Text="?" Foreground="#126B57" FontSize="24"
                                   FontFamily="Segoe UI" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,1,9,0">
                        <TextBlock x:Name="Heading" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"
                                   Background="Transparent" MouseLeftButtonDown="DragHeading"/>
                        <TextBox x:Name="MessageBody" Style="{x:Null}" Margin="0,8,0,0" Padding="0" MaxHeight="260"
                                 BorderThickness="0" Background="Transparent" Foreground="#465E55" FontSize="14"
                                 IsReadOnly="True" IsTabStop="False" TextAlignment="Left" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="提示内容"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="×" FontFamily="Segoe UI" FontSize="20"
                            VerticalAlignment="Top" Width="30" MinHeight="30" Padding="0" Foreground="#526B62"
                            BorderBrush="Transparent" Background="{StaticResource GoldWash}" Focusable="False"
                            AutomationProperties.Name="关闭对话框" ToolTip="关闭" Click="DismissClick"/>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,15,15" Padding="21,13">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="取消" MinWidth="84" Margin="0,0,9,0"
                                IsCancel="True" IsDefault="True" Click="DismissClick"/>
                        <Button x:Name="AcceptButton" MinWidth="102" Style="{DynamicResource Primary}" Click="AcceptClick"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
