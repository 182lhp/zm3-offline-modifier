<Window x:Class="GmStudio.GardenPlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="种植设置 · 修改器" Icon="gm.ico" Width="570" Height="450" MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="{DynamicResource InterfaceFont}" FontSize="13" UseLayoutRounding="True">
    <Border Background="{StaticResource Canvas}" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,17">
                <Border Width="66" Height="66" Background="{StaticResource GoldWash}" CornerRadius="13" Margin="0,0,14,0"><Image x:Name="PlantPreview" Width="48" Height="55"/></Border>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="EditorTitle" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="TargetHint" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="17">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="选择植物" Style="{StaticResource Label}"/><ComboBox x:Name="PlantBox" SelectionChanged="ChoiceChanged" AutomationProperties.Name="种植植物">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="25" Height="25" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="植物品级" Style="{StaticResource Label}"/><ComboBox x:Name="GradeBox" SelectionChanged="ChoiceChanged" AutomationProperties.Name="植物品级"/></StackPanel>
                            </Grid>
                            <TextBlock x:Name="PlantDescription" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource JadeWash}" CornerRadius="10" Padding="13" Margin="0,12,0,12"><TextBlock x:Name="ResultHint" TextWrapping="Wrap"/></Border>
                    <Expander x:Name="AdvancedOptions" Header="日期与原始数据" IsExpanded="False">
                        <StackPanel Margin="0,12,0,6">
                            <TextBlock Text="种植日期（YYYY-MM-DD）" Style="{StaticResource Label}"/><TextBox x:Name="DateBox"/>
                            <StackPanel x:Name="RawPanel" Margin="0,12,0,0"><TextBlock Text="地块 JSON · 修改后以这里为准" Style="{StaticResource Label}"/><TextBox x:Name="RawBox" AcceptsReturn="True" TextWrapping="Wrap" TextAlignment="Left" MinHeight="100" VerticalScrollBarVisibility="Auto"/></StackPanel>
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Row="2" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="取消" IsCancel="True" Click="CancelClick" Margin="0,0,8,0"/><Button Content="应用到存档" Style="{StaticResource Primary}" IsDefault="True" Click="ApplyClick"/></StackPanel>
                <TextBlock Text="保存后生效。" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
