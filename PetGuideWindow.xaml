<Window x:Class="GmStudio.PetGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线宠物图鉴" Icon="gm.ico" Width="840" Height="620" MinWidth="630" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Ink}" FontFamily="{DynamicResource InterfaceFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Padding="18,14" Background="{StaticResource Canvas}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,11">
                <TextBlock Text="离线宠物图鉴" Style="{StaticResource Title}"/>
                <TextBlock Text="按品种和形态查看获取途径、技能与解锁条件。" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="宠物品种" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FamilyBox" DisplayMemberPath="Label" SelectedValuePath="Code"
                                      SelectionChanged="FamilyChanged" AutomationProperties.Name="宠物品种" Margin="0,0,0,9"/>
                            <TextBlock Text="进化形态" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FormBox" DisplayMemberPath="Label" SelectedValuePath="Code"
                                      SelectionChanged="FormChanged" AutomationProperties.Name="进化形态"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="{StaticResource JadeWash}" CornerRadius="9" Padding="8">
                                    <StackPanel>
                                        <ContentPresenter x:Name="GuidePortrait" HorizontalAlignment="Center" ContentTemplate="{StaticResource GuidePortrait}"/>
                                        <TextBlock x:Name="GuideName" FontSize="17" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,2"/>
                                        <TextBlock x:Name="GuideForm" Foreground="{StaticResource Green}" FontSize="12" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource GoldWash}" CornerRadius="9" Padding="9" Margin="0,9,0,0">
                                    <StackPanel>
                                        <TextBlock Text="捕捉与获取" Foreground="{StaticResource GoldInk}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="GuideSource" Style="{StaticResource SourceText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                    <TabControl x:Name="SkillTabs" Style="{StaticResource SegmentTabs}" AutomationProperties.Name="技能分类">
                        <TabControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Heading}"/></DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Intro}" Foreground="{StaticResource Muted}"
                                               TextWrapping="Wrap" FontSize="12" Margin="2,1,2,8"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="7,7,7,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,8">
                                                            <Border.ToolTip><ToolTip Style="{StaticResource SkillHintToolTip}" Content="{Binding Hint}"/></Border.ToolTip>
                                                            <DockPanel>
                                                                <Border x:Name="SkillState" DockPanel.Dock="Right" Background="{StaticResource JadeWash}" CornerRadius="7"
                                                                        Padding="7,3" Margin="7,0,0,0" VerticalAlignment="Top">
                                                                    <TextBlock x:Name="SkillStateText" Text="{Binding Status}" Foreground="{StaticResource Green}" FontSize="11"/>
                                                                </Border>
                                                                <ContentPresenter DockPanel.Dock="Left" Content="{Binding Art}" ContentTemplate="{StaticResource GuideThumb}"
                                                                                  VerticalAlignment="Top" Margin="0,0,8,0"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Art.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Condition}" Foreground="{StaticResource Muted}" FontSize="12"
                                                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11"
                                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                                <Setter TargetName="SkillState" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                                <Setter TargetName="SkillState" Property="Background" Value="{StaticResource GoldWash}"/>
                                                                <Setter TargetName="SkillStateText" Property="Foreground" Value="{StaticResource GoldInk}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Border>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="关闭" Click="CloseClick" IsCancel="True" MinWidth="72" Margin="10,0,0,0"/>
                <TextBlock Text="图鉴可提前查后续技能。编辑时，能添加的数量仍取决于悟性与剩余技能槽。"
                           Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
